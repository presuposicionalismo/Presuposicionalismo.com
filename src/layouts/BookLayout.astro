---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import CoverBook from "../components/CoverBook.astro";
import BookCard from "../components/BookCard.astro";
import AuthorAvatar from "../components/AuthorAvatar.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ArrowLeft from "../components/icons/ArrowLeft.astro";
import ArrowRight from "../components/icons/ArrowRight.astro";
import Download from "../components/icons/Download.astro";
import { resolveAuthors } from "@utils/authors";
import { getSeoDescription } from "@utils/seo";

type Props = CollectionEntry<"libros">["data"] & {
  slug?: string;
  // Si es false, el layout arma "## Sobre el libro" con la `description`.
  hasAbout?: boolean;
  related?: CollectionEntry<"libros">[];
};

const {
  title,
  description,
  seoDescription,
  pubDate,
  coverBook,
  downloadBook,
  authors,
  hasAbout = true,
  related = [],
} = Astro.props;

const resolvedAuthors = await resolveAuthors(authors);

// Determine OG Image
const ogImage = coverBook || "/Portada.png";

// `description` completa se muestra como "Sobre el libro" cuando el body
// no trae ese módulo; `metaDescription` es solo para meta tag/OG/JSON-LD.
const metaDescription = getSeoDescription(description, seoDescription);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: title,
  description: metaDescription,
  url: canonicalURL.toString(),
  image: new URL(ogImage, Astro.site).toString(),
  inLanguage: "es",
  isAccessibleForFree: true,
  bookFormat: "https://schema.org/EBook",
  author: resolvedAuthors.map((author) => ({
    "@type": "Person",
    name: author.data.name,
    url: new URL(`/autores/${author.id}`, Astro.site).toString(),
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Libros",
      item: new URL("/libros", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: canonicalURL.toString(),
    },
  ],
};

const details = [
  { label: "Formato", value: "PDF digital" },
  { label: "Idioma", value: "Español" },
  { label: "Acceso", value: "Gratuito" },
];
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={ogImage}
  structuredData={[bookSchema, breadcrumbSchema]}
>
  <div class="mx-auto w-full max-w-[1200px] px-6 py-10 md:px-10 md:py-14">
    <nav aria-label="Ruta" class="mb-10">
      <a
        href="/libros"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-muted transition-colors hover:text-accent"
      >
        <ArrowLeft class="h-4 w-4" />
        Biblioteca
      </a>
    </nav>

    <!-- Móvil: título, portada, contenido. Escritorio: portada fija a la
         izquierda ocupando ambas filas, título y contenido a la derecha. -->
    <div class="grid grid-cols-1 gap-x-16 gap-y-10 lg:grid-cols-12 lg:grid-rows-[auto_1fr]">
      <!-- Título y autores -->
      <header class="min-w-0 border-b border-border pb-10 lg:col-span-8 lg:col-start-5 lg:row-start-1">
        <p
          class="mb-5 inline-flex items-center rounded bg-accent/10 px-3 py-1 text-xs font-bold tracking-wider text-accent uppercase"
        >
          Apologética Reformada
        </p>
        <h1
          class="serif-text mb-5 text-4xl leading-[1.1] font-bold tracking-tight text-accent md:text-5xl"
        >
          {title}
        </h1>
        {
          resolvedAuthors.length > 0 && (
            <p class="text-lg text-muted">
              <span class="italic">por</span>{" "}
              {resolvedAuthors.map((author, i) => (
                <>
                  <a
                    href={`/autores/${author.id}`}
                    class="font-medium text-accent underline decoration-border underline-offset-4 transition-colors hover:decoration-accent"
                  >
                    {author.data.name}
                  </a>
                  {i < resolvedAuthors.length - 2 && ", "}
                  {i === resolvedAuthors.length - 2 && " y "}
                </>
              ))}
            </p>
          )
        }
      </header>
      <!-- Portada, descarga y ficha técnica -->
      <aside class="lg:col-span-4 lg:row-span-2 lg:row-start-1">
        <div class="flex flex-col gap-6 lg:sticky lg:top-24">
          <div
            class="mx-auto flex w-full max-w-[320px] items-center justify-center rounded-2xl border border-border bg-surface px-[16%] py-[12%] lg:max-w-none"
          >
            <div
              class="relative w-full rounded-r-sm shadow-[16px_22px_40px_-10px_rgb(0_0_0/0.4)]"
            >
              <CoverBook
                imagePath={String(coverBook)}
                altText={`Portada de ${title}`}
                loading="eager"
                transitionName={`coverbook ${title} image`}
                class="aspect-[2/3] w-full rounded-r-sm object-cover"
              />
              <div
                class="pointer-events-none absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/25 via-white/10 to-transparent"
              >
              </div>
            </div>
          </div>

          <a
            href={downloadBook}
            target="_blank"
            rel="noopener"
            class="flex h-12 w-full items-center justify-center gap-3 rounded-lg bg-accent text-background shadow-md transition-all hover:opacity-90 active:scale-[0.98]"
          >
            <Download class="text-[20px]" />
            <span class="text-base font-bold tracking-wide">Descargar PDF gratis</span>
          </a>

          <dl class="divide-y divide-border rounded-xl border border-border text-sm">
            {
              details.map((detail) => (
                <div class="flex items-center justify-between gap-4 px-4 py-3">
                  <dt class="text-muted">{detail.label}</dt>
                  <dd class="font-semibold text-accent">{detail.value}</dd>
                </div>
              ))
            }
            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <dt class="text-muted">En la biblioteca</dt>
              <dd class="font-semibold text-accent">
                <FormattedDate date={pubDate} showIcon={false} />
              </dd>
            </div>
          </dl>
        </div>
      </aside>

      <!-- Contenido -->
      <div class="min-w-0 lg:col-span-8 lg:col-start-5">

        <article class="prose-content">
          {
            !hasAbout && (
              <>
                <h2>Sobre el libro</h2>
                <p>{description}</p>
              </>
            )
          }
          <slot />
        </article>

        {
          resolvedAuthors.length > 0 && (
            <section aria-labelledby="sobre-autores" class="mt-16">
              <h2
                id="sobre-autores"
                class="serif-text mb-6 text-2xl font-semibold text-foreground"
              >
                {resolvedAuthors.length > 1 ? "Sobre los autores" : "Sobre el autor"}
              </h2>
              <div class="flex flex-col gap-4">
                {resolvedAuthors.map((author) => (
                  <a
                    href={`/autores/${author.id}`}
                    class="group flex items-center gap-5 rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent/40"
                  >
                    <AuthorAvatar
                      name={author.data.name}
                      photo={author.data.photo}
                      size="sm"
                      class="shrink-0"
                    />
                    <div class="min-w-0 flex-1">
                      <p class="font-bold text-accent">
                        {author.data.name}
                        {author.data.dates && (
                          <span class="ml-1 font-normal text-muted">
                            ({author.data.dates})
                          </span>
                        )}
                      </p>
                      <p class="mt-1 text-sm leading-relaxed text-muted">
                        {author.data.role}
                      </p>
                    </div>
                    <ArrowRight class="h-4 w-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent" />
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section aria-labelledby="mas-libros" class="mt-24 border-t border-border pt-14">
          <div class="mb-10 flex items-end justify-between gap-4">
            <h2
              id="mas-libros"
              class="serif-text text-3xl font-semibold text-foreground"
            >
              Más de la biblioteca
            </h2>
            <a
              href="/libros"
              class="group hidden items-center gap-1.5 text-sm font-medium text-foreground underline decoration-border underline-offset-4 transition-all hover:text-accent hover:decoration-accent sm:inline-flex"
            >
              Ver todos
              <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </a>
          </div>
          <div class="grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 md:grid-cols-4">
            {related.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
