---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BookCover3D from "../components/BookCover3D.astro";
import BookActions from "../components/BookActions.astro";
import BookDetails from "../components/BookDetails.astro";
import BookInfoTabs from "../components/BookInfoTabs.astro";
import { resolveAuthors, formatAuthorNames } from "@utils/authors";

type Props = CollectionEntry<"libros">["data"] & { slug?: string };

const { title, description, pubDate, coverBook, downloadBook, slug, authors } =
  Astro.props;

const resolvedAuthors = await resolveAuthors(authors);
const authorNames = formatAuthorNames(resolvedAuthors);

// Determine OG Image
const ogImage = coverBook || "/Portada.png";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const bookSchema = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: title,
  description,
  url: canonicalURL.toString(),
  image: new URL(ogImage, Astro.site).toString(),
  author: resolvedAuthors.map((author) => ({
    "@type": "Person",
    name: author.data.name,
    url: new URL(`/autores/${author.id}`, Astro.site).toString(),
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Libros",
      item: new URL("/libros", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
      item: canonicalURL.toString(),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  structuredData={[bookSchema, breadcrumbSchema]}
>
  <div
    class="flex-grow w-full max-w-[1280px] mx-auto px-6 md:px-10 py-8 md:py-12"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Left Column: Book Cover & Actions (40% width on LG) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <BookCover3D
          coverBook={String(coverBook)}
          title={title}
          transitionName={`coverbook ${title} image`}
        />
        <BookActions downloadBook={downloadBook} />
      </div>

      <!-- Right Column: Details (60% width on LG) -->
      <div class="lg:col-span-7 flex flex-col">
        <BookDetails title={title} authorNames={authorNames} />
        <BookInfoTabs
          description={description}
          pubDate={pubDate}
          authors={resolvedAuthors}
        />
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-border w-full my-16"></div>

    <!-- Content Section -->
    <article class="max-w-4xl mx-auto prose-content max-w-none">
      <slot />
    </article>
  </div>
</BaseLayout>
