---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import ShareSidebar from "../components/ShareSidebar.astro";
import AuthorCard from "../components/AuthorCard.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
// import NewsletterCTA from "../components/NewsletterCTA.astro"; // Oculto por ahora, no se usa
import ArticleHeader from "../components/ArticleHeader.astro";
import ArrowLeft from "../components/icons/ArrowLeft.astro";
import { resolveAuthors, formatAuthorNames } from "../utils/authors";
import postFilter from "../utils/postFilter";

type Props = CollectionEntry<"blog">["data"] & {
  slug?: string;
  headings?: { depth: number; slug: string; text: string }[];
};

const { title, description, pubDate, heroImage, slug, tags, headings, authors } =
  Astro.props;

// Si el post tiene `authors` (traducción o extracto atribuible a alguien
// real de /autores), resolvemos y mostramos su bio en vez de la voz
// genérica del equipo editorial. Posts sin `authors` (redactados por el
// equipo de Presuposicionalismo) siguen usando el fallback de AuthorCard.
const postAuthors = authors?.length ? await resolveAuthors(authors) : [];
const primaryAuthor = postAuthors[0];

// Posts relacionados: mismos tags, excluyendo el post actual, priorizando
// mayor cantidad de tags compartidos y luego los más recientes.
const allPosts = await getCollection("blog", postFilter);
const relatedPosts = tags?.length
  ? allPosts
      .filter(
        (p) => p.id !== slug && p.data.tags?.some((t) => tags.includes(t)),
      )
      .sort((a, b) => {
        const overlapA =
          a.data.tags?.filter((t) => tags.includes(t)).length ?? 0;
        const overlapB =
          b.data.tags?.filter((t) => tags.includes(t)).length ?? 0;
        if (overlapB !== overlapA) return overlapB - overlapA;
        return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
      })
      .slice(0, 3)
  : [];

// Resolve heroImage (a content-collection string path like
// "/src/assets/coverblog/foo.webp") to an actual imported asset via
// import.meta.glob. A raw <img src="/src/assets/..."> only works in the
// dev server (Vite serves anything under src/ on request); the static
// build never copies unimported src/ files into dist/, so it 404s there.
const coverImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/coverblog/*.{jpeg,jpg,png,gif,webp}",
);
const resolvedHeroImage =
  heroImage && coverImages[heroImage]
    ? (await coverImages[heroImage]()).default
    : null;

// Determine OG Image — same resolution issue applies to the og:image URL
const ogImage = resolvedHeroImage
  ? (await getImage({ src: resolvedHeroImage })).src
  : "/Portada.png";
---

<BaseLayout title={title} description={description} image={ogImage}>
  <!-- Scroll Progress Bar -->
  <div class="fixed top-0 left-0 h-1 bg-accent z-[60]" id="progress-bar">
  </div>

  <!-- Main Content Area -->
  <div class="flex flex-col items-center w-full pt-12 pb-24">
    <!-- Article Container -->
    <article class="w-full max-w-[800px] px-5 md:px-0 flex flex-col gap-10">
      <!-- Article Header -->
      <ArticleHeader title={title} pubDate={pubDate} tags={tags} />

      <!-- Featured Image -->
      {
        resolvedHeroImage && (
          <figure class="w-full">
            <div class="w-full aspect-[21/9] bg-surface rounded-lg overflow-hidden relative">
              <Image
                src={resolvedHeroImage}
                alt={title}
                class="w-full h-full object-cover rounded-lg"
                widths={[600, 900, 1200]}
                sizes="(min-width: 800px) 800px, 100vw"
                transition:name={`coverblog ${title} image`}
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
            </div>
          </figure>
        )
      }

      <!-- Body Layout Wrapper -->
      <div class="relative w-full">
        <!-- Floating Sidebar (Desktop) -->
        <ShareSidebar title={title} headings={headings} />

        <!-- Typography Content -->
        <div class="prose-content">
          <slot />
        </div>
      </div>

      <!-- Footer Section of Article -->
      <footer class="mt-16 flex flex-col gap-16">
        <!-- Divider -->
        <div class="w-full h-px bg-border"></div>

        <!-- Author Bio -->
        {
          primaryAuthor ? (
            <AuthorCard
              name={formatAuthorNames(postAuthors)}
              bio={primaryAuthor.data.role}
              avatarUrl={primaryAuthor.data.photo}
              profileUrl={`/autores/${primaryAuthor.id}`}
            />
          ) : (
            <AuthorCard />
          )
        }

        <!-- Related Articles -->
        <RelatedArticles posts={relatedPosts} />

        <!-- Newsletter CTA — oculto por ahora, no se usa -->
        <!-- <NewsletterCTA /> -->

        <!-- Back to Blog Link -->
        <div class="text-center">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:underline"
          >
            <ArrowLeft class="text-[18px]" />
            Volver al blog
          </a>
        </div>
      </footer>
    </article>
  </div>

  <!-- Scroll Progress Script -->
  <script is:inline>
    window.addEventListener("scroll", function () {
      let winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      let height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      let scrolled = (winScroll / height) * 100;
      const progressBar = document.getElementById("progress-bar");
      if (progressBar) {
        progressBar.style.width = scrolled + "%";
      }
    });
  </script>
</BaseLayout>
