---
import MainLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import BookCard from "@components/BookCard.astro";
import CoverBook from "@components/CoverBook.astro";
import ArrowRight from "@components/icons/ArrowRight.astro";
import Download from "@components/icons/Download.astro";
import { resolveAuthors, formatAuthorNames } from "@utils/authors";
import { getSeoDescription } from "@utils/seo";

const books = (await getCollection("libros")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const [featured, ...rest] = books;
const featuredAuthors = formatAuthorNames(
  await resolveAuthors(featured.data.authors),
);

// Chips del filtro: cada autor con cuántos libros tiene, más frecuentes
// primero. Se cuentan todos los libros (incluido el destacado) porque el
// filtro también lo muestra en la grilla.
const authorEntries = await resolveAuthors([
  ...new Set(books.flatMap((book) => book.data.authors)),
]);
const authorFilters = authorEntries
  .map((author) => ({
    id: author.id,
    name: author.data.name,
    count: books.filter((book) => book.data.authors.includes(author.id)).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "es"));

const description =
  "Libros y ensayos de apologética reformada y presuposicional traducidos al español, de descarga gratuita en PDF.";
---

<MainLayout title="Libros" description={description}>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <!-- Encabezado -->
    <header class="mb-14 max-w-3xl">
      <div class="mb-4 flex items-center gap-3">
        <div class="h-px w-8 bg-accent/40"></div>
        <p class="text-xs font-bold tracking-[0.25em] text-muted uppercase">
          Biblioteca
        </p>
      </div>
      <h1
        class="serif-text mb-5 text-5xl leading-[1.05] font-medium text-accent md:text-6xl"
      >
        Biblioteca Reformada
      </h1>
      <p class="text-lg leading-relaxed text-muted md:text-xl">
        Libros y ensayos de apologética reformada traducidos al español, para
        edificar la mente y el corazón. Todos se descargan gratis en PDF.
      </p>
      <p class="mt-5 text-sm font-medium text-muted">
        {books.length} títulos · {authorFilters.length} autores
      </p>
    </header>

    <!-- Destacado: el más reciente -->
    <section
      aria-labelledby="destacado"
      class="mb-20 grid items-center gap-10 rounded-2xl border border-border bg-surface p-6 sm:p-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14 lg:p-14"
    >
      <a
        href={`/libros/${featured.id}/`}
        class="mx-auto block w-3/5 max-w-[280px] md:w-full"
        tabindex="-1"
        aria-hidden="true"
      >
        <div
          class="relative rounded-r-sm shadow-[16px_22px_40px_-10px_rgb(0_0_0/0.4)] transition-transform duration-300 hover:-translate-y-1"
        >
          <CoverBook
            imagePath={String(featured.data.coverBook)}
            altText={featured.data.title}
            loading="eager"
            class="aspect-[2/3] w-full rounded-r-sm object-cover"
          />
          <div
            class="pointer-events-none absolute inset-y-0 left-0 w-3 bg-gradient-to-r from-black/25 via-white/10 to-transparent"
          >
          </div>
        </div>
      </a>

      <div>
        <p
          class="mb-4 inline-flex items-center rounded bg-accent/10 px-3 py-1 text-xs font-bold tracking-wider text-accent uppercase"
        >
          Novedad
        </p>
        <h2
          id="destacado"
          class="serif-text mb-3 text-3xl leading-tight font-medium text-accent md:text-4xl"
        >
          <a href={`/libros/${featured.id}/`} class="hover:underline decoration-accent/40 underline-offset-4">
            {featured.data.title}
          </a>
        </h2>
        <p class="mb-6 text-sm font-semibold tracking-[0.15em] text-muted uppercase">
          {featuredAuthors}
        </p>
        <p class="mb-8 max-w-prose text-lg leading-relaxed text-foreground">
          {getSeoDescription(featured.data.description, featured.data.seoDescription)}
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href={`/libros/${featured.id}/`}
            class="inline-flex h-11 items-center gap-2 rounded-lg bg-accent px-5 text-sm font-bold text-background transition-opacity hover:opacity-90"
          >
            Ver el libro
            <ArrowRight class="h-4 w-4" />
          </a>
          <a
            href={featured.data.downloadBook}
            target="_blank"
            rel="noopener"
            class="inline-flex h-11 items-center gap-2 rounded-lg border border-border px-5 text-sm font-bold text-accent transition-colors hover:border-accent"
          >
            <Download class="h-4 w-4" />
            Descargar PDF
          </a>
        </div>
      </div>
    </section>

    <!-- Catálogo -->
    <section aria-labelledby="catalogo" data-book-catalog>
      <div
        class="mb-10 flex flex-col gap-6 border-b border-border pb-6 lg:flex-row lg:items-start lg:justify-between lg:gap-12"
      >
        <h2
          id="catalogo"
          class="serif-text shrink-0 text-3xl font-semibold text-foreground"
        >
          Todos los libros
        </h2>

        <div
          class="flex flex-wrap gap-2 lg:justify-end"
          role="group"
          aria-label="Filtrar por autor"
        >
          <button type="button" class="filter-chip" data-filter="" aria-pressed="true">
            Todos <span class="filter-count">{books.length}</span>
          </button>
          {
            authorFilters.map((author) => (
              <button
                type="button"
                class="filter-chip"
                data-filter={author.id}
                aria-pressed="false"
              >
                {author.name} <span class="filter-count">{author.count}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div
        class="grid grid-cols-2 gap-x-5 gap-y-12 sm:gap-x-8 md:grid-cols-3 xl:grid-cols-4"
      >
        {[featured, ...rest].map((book) => <BookCard book={book} showExcerpt />)}
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-muted);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }

  .filter-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .filter-chip[aria-pressed="true"] {
    color: var(--color-background);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .filter-count {
    font-size: 0.6875rem;
    opacity: 0.7;
  }
</style>

<script>
  // Con ClientRouter los scripts de módulo corren una sola vez, así que
  // el filtro se re-engancha en cada navegación.
  document.addEventListener("astro:page-load", () => {
    const catalog = document.querySelector("[data-book-catalog]");
    if (!catalog) return;

    const chips = catalog.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const cards = catalog.querySelectorAll<HTMLElement>("[data-book-card]");

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const author = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        cards.forEach((card) => {
          const authors = card.dataset.authors?.split(" ") ?? [];
          card.hidden = Boolean(author) && !authors.includes(author!);
        });
      });
    });
  });
</script>
