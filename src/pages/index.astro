---
import MainLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import BlogCarousel from "../components/BlogCarousel.astro";
import FeaturedBooks from "../components/FeaturedBooks.astro";
import Quotes from "../components/Quotes.astro";
import NewsletterCTA from "../components/NewsletterCTA.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero -->
  <Hero />

  <!-- Divider -->
  <div class="mx-auto max-w-6xl px-6">
    <hr class="border-border" />
  </div>

  <!-- Blog Carousel -->
  <BlogCarousel />

  <!-- Divider -->
  <div class="mx-auto max-w-6xl px-6">
    <hr class="border-border" />
  </div>

  <!-- Featured Books -->
  <section class="pt-16 md:pt-20">
    <FeaturedBooks />
  </section>

  <!-- Quotes / Thoughts section -->
  <Quotes />

  <!-- Newsletter CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
    <NewsletterCTA />
  </section>
</MainLayout>
