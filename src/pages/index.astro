---
import MainLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MottoBand from "../components/MottoBand.astro";
import BlogCarousel from "../components/BlogCarousel.astro";
import FeaturedBooks from "../components/FeaturedBooks.astro";
import AuthorsSection from "../components/AuthorsSection.astro";
import Quotes from "../components/Quotes.astro";
// import NewsletterCTA from "../components/NewsletterCTA.astro"; // Oculto por ahora, no se usa
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Hero />

  <!-- Lema del sitio (2 Co 10:5) -->
  <MottoBand />

  <BlogCarousel />

  <div class="mx-auto max-w-6xl px-6">
    <hr class="border-border" />
  </div>

  <FeaturedBooks />

  <div class="mx-auto max-w-6xl px-6">
    <hr class="border-border" />
  </div>

  <AuthorsSection />

  <!-- Quotes / Thoughts section -->
  <Quotes />

  <!-- Newsletter CTA — oculto por ahora, no se usa -->
  <!-- <section id="newsletter" class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
    <NewsletterCTA />
  </section> -->
</MainLayout>
