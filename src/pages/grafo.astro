---
import BaseLayout from "../layouts/BaseLayout.astro";
import GraphView from "../components/GraphView.svelte";
import { getGraphData } from "../utils/graphData";

export const prerender = true;

const data = await getGraphData();
const count = (kind: string) => data.nodes.filter((n) => n.kind === kind).length;
---

<BaseLayout
  title="Mapa de conocimiento"
  description="Explora cómo se conectan los conceptos, artículos y autores del sitio: qué temas trata cada artículo, cuáles se desarrollan o critican entre sí y a quién citan."
>
  <div class="mx-auto max-w-7xl px-6 py-16 md:py-20">
    <section class="mb-10 text-center md:mb-12">
      <h1 class="serif-text mb-5 text-5xl font-medium leading-tight text-accent md:text-6xl">
        Mapa de conocimiento
      </h1>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-muted">
        {count("concepto")} conceptos, {count("articulo")} artículos y {
          count("autor") + count("libro")
        } autores y libros.
      </p>
    </section>

    <GraphView client:load data={data} />
  </div>
</BaseLayout>
