---
import SocialFooter from "./SocialFooter.astro";

const today = new Date();

const links = [
  { href: "/blog/", label: "Blog" },
  { href: "/libros/", label: "Libros" },
  { href: "/autores/", label: "Autores" },
  { href: "/conceptos/", label: "Conceptos" },
  { href: "/grafo", label: "Mapa" },
  { href: "/rss.xml", label: "RSS" },
];
---

<footer class="bg-background border-t border-border py-16 mt-20">
  <div
    class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8"
  >
    <div class="flex flex-col items-center md:items-start gap-4">
      <span class="text-xl font-bold tracking-[0.2em] text-foreground uppercase"
        >Presuposicionalismo</span
      >
      <p class="text-sm text-muted">
        © {today.getFullYear()} Soli Deo Gloria. Todos los derechos reservados.
      </p>
    </div>
    <div class="flex flex-col items-center md:items-end gap-5">
      <nav aria-label="Secciones">
        <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-muted">
          {
            links.map((link) => (
              <li>
                <a href={link.href} class="transition-colors hover:text-foreground">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <SocialFooter />
      <!-- Newsletter oculto por ahora — reactivar este link cuando vuelva la sección -->
      <!-- <a
        href="/#newsletter"
        class="text-sm font-medium text-muted hover:text-accent transition-colors"
      >
        Suscribirse al newsletter
      </a> -->
    </div>
  </div>
</footer>
