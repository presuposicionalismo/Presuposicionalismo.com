---
import BrandX from "./icons/BrandX.astro";
import BrandFacebook from "./icons/BrandFacebook.astro";
import BrandInstagram from "./icons/BrandInstagram.astro";
import BrandYoutube from "./icons/BrandYoutube.astro";

const links = [
  { label: "X", href: "https://twitter.com/Presuposicional/", Icon: BrandX },
  {
    label: "Facebook",
    href: "https://www.facebook.com/Presuposicionalismo/",
    Icon: BrandFacebook,
  },
  {
    label: "Instagram",
    href: "https://www.instagram.com/Presuposicionalismo/",
    Icon: BrandInstagram,
  },
  {
    label: "YouTube",
    href: "https://www.youtube.com/channel/UC8SWa--sH2vDuaCxOFFQN6w",
    Icon: BrandYoutube,
  },
];
---

<div class="flex items-center gap-5 text-muted">
  {
    links.map(({ label, href, Icon }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Síguenos en ${label}`}
        class="hover:text-accent transition-colors"
      >
        <Icon class="text-xl" />
      </a>
    ))
  }
</div>
