---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
}

//  <ViewTransitions >
import { ClientRouter } from "astro:transitions";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = "/Portada.png",
  type = "website",
} = Astro.props;
const ogImage = new URL(image, Astro.url);
---

<!-- Blocking script to avoid FART (Flash of wrong theme) -->
<script is:inline>
  // This code runs immediately before the body is rendered
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  function applyTheme(doc, value) {
    if (value === "light") {
      doc.documentElement.classList.remove("dark");
      doc.documentElement.setAttribute("data-theme", "light");
    } else {
      doc.documentElement.classList.add("dark");
      doc.documentElement.setAttribute("data-theme", "dark");
    }
  }

  // Piel de diseño (data-design en <html>, ver src/styles/tokens.css).
  // Se aplica aquí, antes del primer pintado, para que Grabado no
  // parpadee al cargar. Acepta el formato viejo "theme-grabado".
  function getDesign() {
    const saved = (localStorage.getItem("design-system") || "").replace(
      /^theme-/,
      "",
    );
    return saved === "grabado" ? saved : "ledger";
  }

  function applyDesign(doc, design) {
    doc.documentElement.setAttribute("data-design", design);
  }

  applyTheme(document, theme);
  applyDesign(document, getDesign());
  window.localStorage.setItem("theme", theme);

  // Preserve theme across View Transitions WITHOUT a flash: apply it to
  // the incoming document during astro:before-swap, which runs while the
  // browser is still showing a snapshot of the old page. Fixing the theme
  // up afterwards (astro:after-swap / astro:page-load) is too late --
  // the browser already paints the new document with its default (light)
  // theme for a frame first, which is the flash we were seeing.
  document.addEventListener("astro:before-swap", (event) => {
    const savedTheme = localStorage.getItem("theme") || "light";
    applyTheme(event.newDocument, savedTheme);

    // Mismo arreglo para la piel: el documento entrante trae <html> sin
    // data-design, así que se la ponemos antes de que pinte.
    applyDesign(event.newDocument, getDesign());
  });
</script>
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- <ViewTransitions > -->
<ClientRouter />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
