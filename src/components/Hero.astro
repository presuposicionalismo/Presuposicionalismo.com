---
import { getCollection } from "astro:content";
import CoverBook from "./CoverBook.astro";
import ArrowRight from "./icons/ArrowRight.astro";
import postFilter from "@utils/postFilter";

const [posts, books, authors] = await Promise.all([
  getCollection("blog", postFilter),
  getCollection("libros"),
  getCollection("autores"),
]);

// Abanico de portadas: los tres libros más recientes, el más nuevo al frente.
const fan = books
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .reverse();

const fanPosition = [
  "left-0 top-10 -rotate-[9deg] w-[46%]",
  "right-0 top-6 rotate-[7deg] w-[46%]",
  "left-1/2 top-0 -translate-x-1/2 w-[52%] z-10",
];

const stats = [
  { value: posts.length, label: "artículos", href: "/blog/" },
  { value: books.length, label: "libros gratuitos", href: "/libros/" },
  { value: authors.length, label: "autores", href: "/autores/" },
];
---

<section
  class="mx-auto grid max-w-6xl items-center gap-14 px-6 pt-14 pb-16 md:pt-24 md:pb-24 lg:grid-cols-12 lg:gap-10"
>
  <div class="lg:col-span-8">
    <!-- Eyebrow -->
    <div class="mb-6 flex items-center gap-3">
      <div class="h-px w-8 bg-accent/40"></div>
      <p class="text-xs font-bold tracking-[0.25em] text-muted uppercase">
        Apologética Presuposicional
      </p>
    </div>

    <!-- Headline: saltos de línea deliberados desde sm; en móvil fluye natural
         (cada línea no cabe en 390px y se partía en dos). -->
    <h1
      class="serif-text text-[2rem] leading-[1.12] font-semibold tracking-tight text-foreground sm:text-5xl lg:text-[2.6rem] xl:text-[3rem]"
    >
      <!-- El espacio va dentro de cada span: el compresor de HTML del build
           borra un {" "} suelto entre etiquetas. -->
      <span class="sm:block">¿Estás preparado para algo&#32;</span>
      <span class="italic text-accent sm:block">intelectualmente estimulante&#32;</span>
      <span class="sm:block">y conmovedor para el alma?</span>
    </h1>

    <p class="mt-7 max-w-xl text-base leading-relaxed text-muted md:text-lg">
      Literatura que suscribe una filosofía distintivamente cristiana, enfocada
      en la metodología apologética del Dr. Cornelius Van Til y sus
      estudiantes.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 rounded-lg bg-foreground px-6 py-3 text-sm font-semibold text-background transition-opacity duration-200 hover:opacity-85"
      >
        Explorar artículos
        <ArrowRight class="h-4 w-4" />
      </a>
      <a
        href="/libros/"
        class="inline-flex items-center gap-2 rounded-lg border border-border px-6 py-3 text-sm font-medium text-foreground transition-colors duration-200 hover:border-foreground/40 hover:bg-surface"
      >
        Ver biblioteca
      </a>
    </div>

    <dl class="mt-12 flex flex-wrap gap-x-8 gap-y-4 border-t sm:gap-x-10 border-border pt-6">
      {
        stats.map((stat) => (
          <a href={stat.href} class="group flex flex-col-reverse">
            <dt class="text-xs font-semibold tracking-widest text-muted uppercase">
              {stat.label}
            </dt>
            <dd class="serif-text text-3xl font-semibold text-foreground transition-colors group-hover:text-accent">
              {stat.value}
            </dd>
          </a>
        ))
      }
    </dl>
  </div>

  <!-- Abanico de portadas -->
  <div class="mx-auto w-full max-w-[280px] sm:max-w-sm lg:col-span-4 lg:max-w-none">
    <div class="relative aspect-[5/4]">
      {
        fan.map((book, i) => (
          <a
            href={`/libros/${book.id}/`}
            class={`group absolute block transition-transform duration-300 hover:-translate-y-2 ${fanPosition[i]}`}
            aria-label={book.data.title}
          >
            <div class="relative rounded-r-sm shadow-[14px_20px_36px_-10px_rgb(0_0_0/0.45)]">
              <CoverBook
                imagePath={String(book.data.coverBook)}
                altText=""
                loading="eager"
                class="aspect-[2/3] w-full rounded-r-sm object-cover"
              />
              <div class="pointer-events-none absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/25 via-white/10 to-transparent" />
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
