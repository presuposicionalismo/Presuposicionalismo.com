---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import FormattedDate from "./FormattedDate.astro";
import ArrowRight from "./icons/ArrowRight.astro";
import { slugifyStr } from "@utils/slugify";

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts[0];
const rest = allPosts.slice(1, 5);

// Resolve images safely — never throws
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/coverblog/*.{jpeg,jpg,png,gif,webp}",
);

async function resolveImage(path: string | undefined) {
  if (!path || !images[path]) return null;
  return (await images[path]()).default;
}

const featuredImg = featured ? await resolveImage(featured.data.heroImage) : null;
const restImgs = await Promise.all(rest.map((p) => resolveImage(p.data.heroImage)));
---

<section class="mx-auto max-w-6xl px-6 py-16 md:py-24">
  <!-- Header -->
  <div class="mb-10 flex items-end justify-between gap-4">
    <div>
      <div class="mb-3 flex items-center gap-3">
        <div class="h-px w-8 bg-accent/40"></div>
        <p class="text-xs font-bold tracking-[0.25em] text-muted uppercase">Blog</p>
      </div>
      <h2 class="serif-text text-3xl font-semibold text-foreground md:text-4xl">
        Últimas entradas
      </h2>
    </div>
    <a
      href="/blog/"
      class="group hidden shrink-0 items-center gap-1.5 text-sm font-medium text-foreground underline decoration-border underline-offset-4 transition-all hover:text-accent hover:decoration-accent md:inline-flex"
    >
      Ver todas
      <ArrowRight class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
  </div>

  <!-- Main grid -->
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-5 lg:grid-rows-1">

    <!-- Featured post (large, 3 cols) -->
    {featured && (
      <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-surface lg:col-span-3">
        <!-- Image -->
        <a href={`/blog/${slugifyStr(featured.data.title)}/`} class="relative block aspect-[16/9] overflow-hidden lg:aspect-auto lg:flex-1" tabindex="-1" aria-hidden="true">
          {featuredImg ? (
            <Image
              src={featuredImg}
              alt={featured.data.title}
              class="h-full w-full object-cover rounded-t-2xl transition-transform duration-500 group-hover:scale-105"
              widths={[800, 1200]}
              sizes="(min-width: 1024px) 60vw, 100vw"
              transition:name={`coverblog ${featured.data.title} image`}
            />
          ) : (
            <div class="flex h-full min-h-52 w-full items-center justify-center bg-muted/30">
              <svg class="h-12 w-12 text-border" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 16l5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          )}
          <span class="absolute inset-0 bg-foreground/0 transition-colors duration-300 group-hover:bg-foreground/5"></span>
        </a>

        <!-- Content -->
        <div class="flex flex-col gap-3 p-6 md:p-7">
          <span class="text-[11px] font-semibold tracking-widest text-muted uppercase">
            <FormattedDate date={featured.data.pubDate} />
          </span>
          <h3 class="serif-text text-xl font-semibold leading-snug text-foreground transition-colors duration-200 group-hover:text-accent md:text-2xl">
            <a href={`/blog/${slugifyStr(featured.data.title)}/`}>{featured.data.title}</a>
          </h3>
          <p class="line-clamp-2 text-sm leading-relaxed text-muted">{featured.data.description}</p>
          <a
            href={`/blog/${slugifyStr(featured.data.title)}/`}
            class="group/link mt-1 inline-flex w-fit items-center gap-1.5 text-sm font-medium text-accent"
          >
            Leer artículo
            <ArrowRight class="h-3.5 w-3.5 transition-transform duration-200 group-hover/link:translate-x-0.5" />
          </a>
        </div>
      </article>
    )}

    <!-- Secondary posts (2 cols, stacked) -->
    <div class="flex flex-col gap-4 lg:col-span-2">
      {rest.map((post, i) => (
        <article class="group flex gap-4 overflow-hidden rounded-xl border border-border bg-surface p-4 transition-shadow duration-300 hover:shadow-sm">
          <!-- Thumbnail -->
          {restImgs[i] ? (
            <a href={`/blog/${slugifyStr(post.data.title)}/`} class="relative block h-20 w-20 shrink-0 overflow-hidden rounded-lg" tabindex="-1" aria-hidden="true">
              <Image
                src={restImgs[i]!}
                alt={post.data.title}
                class="h-full w-full object-cover rounded-lg transition-transform duration-500 group-hover:scale-105"
                width={80}
                height={80}
                transition:name={`coverblog ${post.data.title} image`}
              />
            </a>
          ) : (
            <div class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-muted/20">
              <svg class="h-6 w-6 text-border" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
          )}

          <!-- Text -->
          <div class="flex min-w-0 flex-col justify-center gap-1.5">
            <span class="text-[10px] font-semibold tracking-widest text-muted uppercase">
              <FormattedDate date={post.data.pubDate} />
            </span>
            <h3 class="serif-text line-clamp-2 text-sm font-semibold leading-snug text-foreground transition-colors duration-200 group-hover:text-accent">
              <a href={`/blog/${slugifyStr(post.data.title)}/`}>{post.data.title}</a>
            </h3>
          </div>
        </article>
      ))}

      <!-- Mobile "Ver todas" -->
      <div class="mt-2 md:hidden">
        <a
          href="/blog/"
          class="text-sm font-medium text-foreground underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent"
        >
          Ver todas las entradas →
        </a>
      </div>
    </div>
  </div>
</section>
