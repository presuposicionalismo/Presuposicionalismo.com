---
import CalendarEvent from "./icons/CalendarEvent.astro";

interface Props {
  date: Date;
  showIcon?: boolean;
}

const { date, showIcon = true } = Astro.props;
---

<div class="inline-flex items-center gap-1.5">
  {
    showIcon && (
      <span class="inline-flex shrink-0">
        <CalendarEvent />
      </span>
    )
  }
  <span class="inline-flex">
    <time datetime={date.toISOString()}>
      {
        date.toLocaleDateString("es-co", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </time>
  </span>
</div>
