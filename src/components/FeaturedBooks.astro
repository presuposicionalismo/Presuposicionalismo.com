---
import { getCollection } from "astro:content";
import CoverBook from "./CoverBook.astro";
import ArrowRight from "./icons/ArrowRight.astro";
import { resolveAuthors, formatAuthorNames } from "@utils/authors";

const allBooks = (await getCollection("libros")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredBooks = await Promise.all(
  allBooks.slice(0, 4).map(async (book) => ({
    book,
    authorNames: formatAuthorNames(await resolveAuthors(book.data.authors)),
  })),
);
---

<section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
  <!-- Header -->
  <div class="mb-10 flex items-end justify-between gap-4">
    <div>
      <div class="mb-3 flex items-center gap-3">
        <div class="h-px w-8 bg-accent/40"></div>
        <p class="text-xs font-bold tracking-[0.25em] text-muted uppercase">Biblioteca</p>
      </div>
      <h2 class="serif-text text-3xl font-semibold text-foreground md:text-4xl">
        Libros Destacados
      </h2>
      <p class="mt-2 text-sm text-muted">
        Recursos esenciales de apologética y teología reformada.
      </p>
    </div>
    <a
      href="/libros/"
      class="group hidden shrink-0 items-center gap-1.5 text-sm font-medium text-foreground underline decoration-border underline-offset-4 transition-all hover:text-accent hover:decoration-accent md:inline-flex"
    >
      Ver todos
      <ArrowRight class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" />
    </a>
  </div>

  <!-- Grid -->
  <div class="grid grid-cols-2 gap-5 sm:grid-cols-4">
    {
      featuredBooks.map(({ book, authorNames }) => (
        <article class="group flex flex-col gap-3">
          <!-- Cover -->
          <a
            href={`/libros/${book.id}/`}
            class="block aspect-[3/4] overflow-hidden rounded-xl border border-border bg-surface shadow-sm transition-all duration-300 hover:shadow-md"
          >
            <CoverBook
              imagePath={String(book.data.coverBook)}
              altText={book.data.title}
              class="h-full w-full object-cover rounded-xl transition-transform duration-500 group-hover:scale-105"
              transitionName={`coverbook ${book.data.title} image`}
            />
          </a>

          <!-- Info -->
          <div class="flex flex-col gap-1 px-0.5">
            {authorNames && (
              <p class="text-[10px] font-semibold tracking-widest text-muted uppercase truncate">
                {authorNames}
              </p>
            )}
            <a href={`/libros/${book.id}/`}>
              <h3 class="serif-text line-clamp-2 text-sm leading-snug font-medium text-foreground transition-colors duration-200 group-hover:text-accent">
                {book.data.title}
              </h3>
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <!-- Mobile "Ver todos" -->
  <div class="mt-8 text-center md:hidden">
    <a
      href="/libros/"
      class="text-sm font-medium text-foreground underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent"
    >
      Ver todos los libros
    </a>
  </div>
</section>
