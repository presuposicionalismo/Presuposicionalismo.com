---
const quotes = [
  {
    text: "El Cristianismo es verdadero en virtud de la imposibilidad de lo contrario.",
    name: "Greg L. Bahnsen",
    source: "Always Ready",
    span: "col-span-2",
  },
  {
    text: "Todo conocimiento humano presupone al Dios trino de las Escrituras.",
    name: "Cornelius Van Til",
    source: "A Survey of Christian Epistemology",
    span: "col-span-1",
  },
  {
    text: "El incrédulo suprime la verdad de Dios en injusticia; sin embargo, la necesita para pensar y vivir.",
    name: "John M. Frame",
    source: "Apologetics to the Glory of God",
    span: "col-span-1",
  },
  {
    text: "La apologética no es un asunto periférico de la fe cristiana; es el corazón de ella.",
    name: "Greg L. Bahnsen",
    source: "Van Til's Apologetic",
    span: "col-span-2",
  },
];
---

<section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
  <!-- Header -->
  <div class="mb-10">
    <div class="mb-3 flex items-center gap-3">
      <div class="h-px w-8 bg-accent/40"></div>
      <p class="text-xs font-bold tracking-[0.25em] text-muted uppercase">Pensamiento</p>
    </div>
    <h2 class="serif-text text-3xl font-semibold text-foreground md:text-4xl">
      Voces que Desafían
    </h2>
  </div>

  <!-- Bento grid -->
  <div class="grid auto-rows-auto grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
    {
      quotes.map((quote, i) => (
        <figure
          class:list={[
            "group flex flex-col justify-between gap-6 rounded-2xl border border-border bg-surface p-7 transition-shadow duration-300 hover:shadow-md",
            // Alternate accent background for variety
            i === 0 ? "border-foreground/10 bg-foreground text-background" : "",
          ]}
        >
          <!-- Opening quote mark -->
          <span
            class:list={[
              "font-serif text-5xl leading-none select-none",
              i === 0 ? "text-background/20" : "text-foreground/10",
            ]}
            aria-hidden="true"
          >
            &ldquo;
          </span>

          <blockquote
            class:list={[
              "serif-text flex-1 text-lg leading-relaxed font-medium",
              i === 0 ? "text-background" : "text-foreground",
            ]}
          >
            {quote.text}
          </blockquote>

          <figcaption class="flex flex-col gap-0.5">
            <p
              class:list={[
                "text-sm font-semibold",
                i === 0 ? "text-background/90" : "text-foreground",
              ]}
            >
              {quote.name}
            </p>
            <p
              class:list={[
                "text-xs italic",
                i === 0 ? "text-background/50" : "text-muted",
              ]}
            >
              {quote.source}
            </p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
