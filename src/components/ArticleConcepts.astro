---
import { getConceptsForPost } from "@utils/concepts";

interface Props {
  // Id del post en la colección "blog".
  postId: string;
}

const MAX = 6;
const concepts = (await getConceptsForPost(Astro.props.postId)).slice(0, MAX);
---

{
  concepts.length > 0 && (
    <section class="flex flex-col gap-4" aria-labelledby="article-concepts">
      <div class="flex items-center justify-between">
        <h3 id="article-concepts" class="serif-text text-2xl font-bold text-accent">
          Conceptos de este artículo
        </h3>
        <a
          class="hidden text-sm font-medium text-muted transition-colors hover:text-accent sm:block"
          href="/grafo"
        >
          Ver el mapa
        </a>
      </div>
      <ul class="flex flex-wrap gap-3">
        {concepts.map((concept) => (
          <li>
            <a
              href={`/conceptos/${concept.id}`}
              title={concept.description}
              class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm text-foreground transition-colors hover:border-accent hover:text-accent"
            >
              {concept.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
