---
import type { CollectionEntry } from "astro:content";
import CoverBook from "./CoverBook.astro";
import { resolveAuthors, formatAuthorNames } from "@utils/authors";
import { getSeoDescription } from "@utils/seo";

interface Props {
  book: CollectionEntry<"libros">;
  // En la biblioteca se muestra un resumen corto; en grillas compactas
  // (perfil de autor, "más libros") basta con portada, autor y título.
  showExcerpt?: boolean;
}

const { book, showExcerpt = false } = Astro.props;
const authors = await resolveAuthors(book.data.authors);
const excerpt = getSeoDescription(book.data.description, book.data.seoDescription);
---

<article
  class="group relative flex h-full flex-col"
  data-book-card
  data-authors={book.data.authors.join(" ")}
>
  <a href={`/libros/${book.id}/`} class="flex flex-1 flex-col">
    <!-- Cover sobre un "atril": fondo de superficie y libro con lomo -->
    <div
      class="relative mb-5 flex aspect-[4/5] items-center justify-center rounded-xl border border-border bg-surface px-[18%] py-[12%] transition-colors duration-300 group-hover:border-accent/30"
    >
      <div
        class="relative w-full rounded-r-sm shadow-[10px_14px_28px_-8px_rgb(0_0_0/0.35)] transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:rotate-[-1deg]"
      >
        <CoverBook
          imagePath={String(book.data.coverBook)}
          altText={book.data.title}
          transitionName={`coverbook ${book.data.title} image`}
          class="aspect-[2/3] w-full rounded-r-sm object-cover"
        />
        <!-- Lomo -->
        <div
          class="pointer-events-none absolute inset-y-0 left-0 w-2.5 bg-gradient-to-r from-black/25 via-white/10 to-transparent"
        >
        </div>
      </div>
    </div>

    <div class="flex flex-1 flex-col">
      {
        authors.length > 0 && (
          <p class="mb-2 text-[11px] font-semibold tracking-[0.18em] text-muted uppercase">
            {formatAuthorNames(authors)}
          </p>
        )
      }
      <h3
        class="serif-text text-xl leading-snug font-medium text-accent decoration-accent/40 underline-offset-4 group-hover:underline"
      >
        {book.data.title}
      </h3>
      {
        showExcerpt && (
          <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
            {excerpt}
          </p>
        )
      }
    </div>
  </a>
</article>
