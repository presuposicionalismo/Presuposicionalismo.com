{
  "name": "presuposicionalismo.com",
  "version": "0.82",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "bunx oxfmt .",
    "format:check": "bunx oxfmt --check .",
    "lint": "bunx oxlint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "@astrojs/vercel": "^11.0.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.1.6",
    "bits-ui": "^2.18.1",
    "d3": "^7.9.0",
    "lodash.kebabcase": "^4.1.1",
    "mermaid": "^11.16.0",
    "postcss": "^8.5.25",
    "postcss-custom-media": "^11.0.6",
    "postcss-nesting": "^13.0.2",
    "sharp": "^0.34.5",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/lodash.kebabcase": "^4.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.69.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,mjs,cjs,json,md,mdx}": [
      "bunx oxfmt"
    ],
    "*.{astro,js,ts,tsx,jsx,mjs,cjs}": [
      "bunx oxlint --fix"
    ],
    "*.{astro,ts,tsx}": [
      "astro check --minimumSeverity warning --noWatch"
    ]
  }
}
